PORT=3000
DATABASE_URL=postgresql://localhost:5432/content_manager
# Optional loopback-only HTTPS: configure both paths; keep certificates outside Git.
LOCAL_HTTPS_KEY_PATH=
LOCAL_HTTPS_CERT_PATH=
SOCIAL_CREDENTIAL_ENCRYPTION_KEY=
META_GRAPH_API_VERSION=v25.0
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:3000/social/connections/youtube/callback
INSTAGRAM_OAUTH_CLIENT_ID=
INSTAGRAM_OAUTH_CLIENT_SECRET=
INSTAGRAM_OAUTH_REDIRECT_URI=http://localhost:3000/social/connections/instagram/callback
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_REDIRECT_URI=http://localhost:3000/social/connections/facebook/callback
# Required when the Meta app only offers Facebook Login for Business:
# the login configuration ID created in the app's dashboard.
FACEBOOK_OAUTH_CONFIG_ID=
TIKTOK_BUSINESS_CLIENT_ID=
TIKTOK_BUSINESS_CLIENT_SECRET=
TIKTOK_BUSINESS_REDIRECT_URI=
TIKTOK_BUSINESS_AUTHORIZATION_URL=
TIKTOK_BUSINESS_STATE_PARAMETER=state
