DATABASE_URL=postgresql://content_manager:REPLACE_WITH_A_LONG_URL_SAFE_RANDOM_SECRET@postgres:5432/content_manager
SOCIAL_CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY

# Phase 1 remote deployment gate; current runtime does not consume these yet.
OIDC_ISSUER=https://REPLACE_WITH_AUTH0_DOMAIN/
OIDC_AUDIENCE=REPLACE_WITH_AUTH0_API_IDENTIFIER
OIDC_JWKS_URI=https://REPLACE_WITH_AUTH0_DOMAIN/.well-known/jwks.json
AUTH0_DOMAIN=REPLACE_WITH_AUTH0_DOMAIN
AUTH0_CLIENT_ID=REPLACE_WITH_AUTH0_APPLICATION_CLIENT_ID
AUTH0_CLIENT_SECRET=REPLACE_WITH_AUTH0_APPLICATION_CLIENT_SECRET
AUTH0_SECRET=REPLACE_WITH_SERVER_SIDE_SESSION_SECRET
APP_BASE_URL=https://content-manager.example.com
